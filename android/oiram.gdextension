[configuration]
entry_symbol = "oiram_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/liboiram.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liboiram.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/liboiram.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/liboiram.android.template_release.arm64.so"
